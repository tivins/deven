#!/usr/bin/env bash



function getDir() {
  local dir
  dir="$(dirname "$(readlink "$0")")"
  echo "$dir"
}
trim() {
  local __in="$1"
  printf '%s' "$__in" | sed -e 's/^[[:space:]]\+//' -e 's/[[:space:]]\+$//'
}


COMMAND=$1
ARG1=$2
. "$(getDir)/.env"


case "$COMMAND" in
""|help)
  echo "🚀 Deven - Dockerized Development Environment"
  echo ""
  echo "Usage: deven <command> [options]"
  echo ""
  echo "Commands:"
  echo "  build              Build and start all containers"
  echo "  restart            Restart all containers"
  echo "  stop               Stop all containers"
  echo "  ps                 Show running deven containers"
  echo "  list               List configured virtual hosts"
  echo "  edit               Edit sites.conf configuration file"
  echo "  dump [database]    Create database backup (all dbs if no name specified)"
  echo "  bash [container]   Open bash shell in container (default: web)"
  echo "  cd                 Display deven directory path"
  echo "  version            Show deven version"
  echo "  help               Show this help message"
  echo ""
  echo "Examples:"
  echo "  deven build                    # Start the development environment"
  echo "  deven bash                     # Access web container shell"
  echo "  deven bash db                  # Access database container shell"
  echo "  deven dump my_database         # Backup specific database"
  echo "  deven list                     # Show configured sites"
  echo ""
  echo "For more information, visit: https://github.com/tivins/deven"
  ;;
version)
  echo "1"
  ;;
cd)
  echo "$(getDir)"
  ;;
build)
  docker compose up --build -d
  ;;
stop)
  docker compose stop
  ;;
restart)
  docker compose stop
  docker compose up -d
  ;;
ps)
  docker ps | grep deven
  ;;
list)
  file="$(getDir)/docker/web/apache/sites.conf"
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    read -ra parts <<< "$line"
    port="$(trim "$HTTP_PORT")"
    echo "- http://${parts[2]}:$port/ -> ${parts[3]}"
  done < "$file"
  ;;
edit)
  file="$(getDir)/docker/web/apache/sites.conf"
  vim "$file"
  ;;
dump)
  $(getDir)/scripts/dump.sh "$ARG1"
  ;;
bash)
  if [ -z "$ARG1" ]; then
    container="deven_web"
  else
    container="deven_$ARG1"
  fi
  docker exec -it "$container" bash
  ;;
*)
  echo "░█ Command not found."
  ;;
esac